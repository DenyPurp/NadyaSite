// Prisma schema for NadyaSite (step 0.2 — model skeleton)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum MaterialType {
  FILE
  LINK
  TEXT
}

enum AssignmentTemplateType {
  TEST
  EXERCISE
  LINK
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  displayName  String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments      Enrollment[]
  lessons          Lesson[]          @relation("StudentLessons")
  assignmentIssues AssignmentIssue[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  lessons     Lesson[]
  materials   Material[]
}

/// Ученик ↔ курс
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

/// Персональный архив занятия (календарь ученика)
model Lesson {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  topic     String
  notes     String?
  courseId  String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User       @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([studentId, date])
  @@index([courseId])
}

/// Материал: файл / ссылка / текст; к курсу и/или уроку
model Material {
  id        String       @id @default(cuid())
  title     String
  type      MaterialType
  content   String?
  fileUrl   String?
  courseId  String?
  lessonId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lessonId])
}

/// Банк шаблонов заданий (тест / упражнение / ссылка)
model AssignmentTemplate {
  id        String                 @id @default(cuid())
  title     String
  type      AssignmentTemplateType
  content   String?
  topics    String[]               @default([])
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  items AssignmentItem[]
}

/// Выдача заданий ученику на 10/20 число (идемпотентно по studentId + issueDate)
model AssignmentIssue {
  id        String    @id @default(cuid())
  studentId String
  issueDate DateTime  @db.Date
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   AssignmentItem[]

  @@unique([studentId, issueDate])
  @@index([issueDate])
}

/// Конкретные пункты выдачи (из шаблонов по темам за период)
model AssignmentItem {
  id         String                  @id @default(cuid())
  issueId    String
  templateId String?
  title      String
  content    String?
  type       AssignmentTemplateType?
  createdAt  DateTime                @default(now())

  issue    AssignmentIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  template AssignmentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([templateId])
}
